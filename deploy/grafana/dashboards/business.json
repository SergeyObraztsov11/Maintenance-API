      "title": "Среднее время закрытия (часы)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
          "editorType": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT AVG(EXTRACT(EPOCH FROM (h.created_at - r.created_at)) / 3600.0) AS hours\nFROM maintenance_requests r\nJOIN request_status_history h\n  ON h.request_id = r.id AND h.to_status = 'done'\nWHERE r.status = 'done';",
          "refId": "A"
        }
      ]
