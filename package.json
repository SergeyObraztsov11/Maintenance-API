{
  "name": "maintenance-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seedDb.js",
    "lint:check": "eslint src",
    "lint:fix": "eslint src --fix",
    "format:check": "prettier --check src",
    "format:fix": "prettier --write src",
    "check": "npm run lint:check && npm run format:check",
    "fix": "npm run lint:fix && npm run format:fix",
    "docker:build": "docker build -t maintenance-api .",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "docker:seed": "docker compose exec api node src/scripts/seedDb.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:show-tables": "docker compose exec db psql -U maintenance -d maintenance -c \"\\dt\"",
    "db:show-table": "node src/scripts/dbTable.js structure",
    "db:show-table-data": "node src/scripts/dbTable.js data"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "prom-client": "^15.1.3",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "sequelize-cli": "^6.6.5"
  }
}
