{
  "info": {
    "name": "Maintenance API",
    "description": "Case 3: Maintenance API (PostgreSQL).\n\nVariables: baseUrl, apiKey, equipmentId, requestId, serialNumber, technicianId, technicianId2, siteId.\n\nSuggested order: Health → Setup seed IDs → Equipment → Requests (assignees before in_progress) → Reports → Negative.\nRequires: docker db up, migrate, seed, npm start.\nFor 429: temporarily set RATE_LIMIT_MAX=3.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "apiKey",
      "value": "dev-api-key-change-me"
    },
    {
      "key": "equipmentId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "serialNumber",
      "value": "SN-POSTMAN-001"
    },
    {
      "key": "technicianId",
      "value": ""
    },
    {
      "key": "technicianId2",
      "value": ""
    },
    {
      "key": "siteId",
      "value": ""
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has status ok', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('status', 'ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Setup",
      "item": [
        {
          "name": "Resolve seed IDs (site + technicians)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const eqBody = pm.response.json();",
                  "pm.expect(eqBody.data).to.be.an(\"array\").that.is.not.empty;",
                  "pm.collectionVariables.set(\"siteId\", eqBody.data[0].siteId);",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get(\"baseUrl\") + \"/api/requests?page=1&limit=50\",",
                  "  method: \"GET\",",
                  "  header: { \"X-API-Key\": pm.collectionVariables.get(\"apiKey\") }",
                  "}, (err, res) => {",
                  "  pm.test(\"Loaded technicians from requests\", () => {",
                  "    pm.expect(err).to.eql(null);",
                  "    const rows = res.json().data || [];",
                  "    const ids = [];",
                  "    for (const r of rows) {",
                  "      for (const a of r.assignees || []) {",
                  "        if (a.technician && a.technician.id && !ids.includes(a.technician.id)) {",
                  "          ids.push(a.technician.id);",
                  "        }",
                  "      }",
                  "    }",
                  "    pm.expect(ids.length).to.be.at.least(1);",
                  "    pm.collectionVariables.set(\"technicianId\", ids[0]);",
                  "    pm.collectionVariables.set(\"technicianId2\", ids[1] || ids[0]);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment?page=1&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipment"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Requires npm run seed. Saves siteId and technician IDs from seeded data."
          }
        }
      ]
    },
