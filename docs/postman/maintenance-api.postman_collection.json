{
  "info": {
    "name": "Maintenance API",
    "description": "Case 2: equipment and maintenance requests REST API.\n\nVariables: baseUrl, equipmentId, requestId, serialNumber.\n\nRun Health → Create equipment → Create request, then other requests. Negative folder covers 422/404/409/429.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "equipmentId", "value": "" },
    { "key": "requestId", "value": "" },
    { "key": "serialNumber", "value": "SN-POSTMAN-001" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has status ok', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('status', 'ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Equipment",
      "item": [
        {
          "name": "POST create equipment",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('serialNumber', 'SN-POSTMAN-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Body has data.id', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body.data).to.have.property('id');",
                  "  pm.collectionVariables.set('equipmentId', body.data.id);",
                  "});",
                  "pm.test('Location header exists', () => {",
                  "  pm.expect(pm.response.headers.has('Location')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Turbine\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"{{serialNumber}}\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.61 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2024-01-15\"\n}"
            },
            "url": "{{baseUrl}}/api/equipment"
          }
        },
        {
          "name": "GET list equipment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has data and meta', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body).to.have.property('meta');",
                  "  pm.expect(body.meta).to.include.keys('total', 'page', 'limit');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment?page=1&limit=10&sortBy=createdAt&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortOrder", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "GET equipment by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has data', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.have.property('id', pm.collectionVariables.get('equipmentId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}"
          }
        },
        {
          "name": "PATCH update equipment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has data', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('data');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"maintenance\"\n}"
            },
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}"
          }
        },
        {
          "name": "GET equipment weather",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has forecast', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.have.property('forecast');",
                  "  pm.expect(body.data.forecast).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment/{{equipmentId}}/weather?days=3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment", "{{equipmentId}}", "weather"],
              "query": [{ "key": "days", "value": "3" }]
            }
          }
        },
        {
          "name": "GET equipment requests",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has data and meta', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body).to.have.property('meta');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}/requests"
          }
        },
        {
          "name": "DELETE equipment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204 or 409', () => {",
                  "  pm.expect([204, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}",
            "description": "204 if no open requests; 409 if open requests exist."
          }
        }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "POST create request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Body has data.id', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.have.property('id');",
                  "  pm.collectionVariables.set('requestId', body.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipmentId\": \"{{equipmentId}}\",\n  \"title\": \"Postman inspection request\",\n  \"description\": \"Created from Postman collection\",\n  \"priority\": \"medium\",\n  \"plannedAt\": \"2026-09-25T09:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/api/requests"
          }
        },
        {
          "name": "GET list requests",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has data and meta', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body).to.have.property('meta');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET request by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has data', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('data');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/requests/{{requestId}}"
          }
        },
        {
          "name": "PATCH update request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has data', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('data');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"high\"\n}"
            },
            "url": "{{baseUrl}}/api/requests/{{requestId}}"
          }
        },
        {
          "name": "PATCH change status to in_progress",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status became in_progress', () => {",
                  "  pm.expect(pm.response.json().data.status).to.eql('in_progress');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\"\n}"
            },
            "url": "{{baseUrl}}/api/requests/{{requestId}}/status"
          }
        },
        {
          "name": "DELETE request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/requests/{{requestId}}"
          }
        }
      ]
    },
    {
      "name": "Negative",
      "item": [
        {
          "name": "422 validation error - short name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('Error format', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.have.property('code', 'VALIDATION_ERROR');",
                  "  pm.expect(body.error).to.have.property('details');",
                  "  pm.expect(body.error.details).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ab\"\n}"
            },
            "url": "{{baseUrl}}/api/equipment"
          }
        },
        {
          "name": "404 equipment not found",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error code NOT_FOUND', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/equipment/11111111-1111-1111-1111-111111111110"
          }
        },
        {
          "name": "409 duplicate serial number",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sn = 'SN-DUP-' + Date.now();",
                  "pm.collectionVariables.set('dupSerial', sn);",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/equipment',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: {",
                  "    mode: 'raw',",
                  "    raw: JSON.stringify({",
                  "      name: 'Dup Turbine',",
                  "      type: 'turbine',",
                  "      serialNumber: sn,",
                  "      location: { lat: 55.75, lon: 37.61 },",
                  "      status: 'operational',",
                  "      installedAt: '2024-01-15'",
                  "    })",
                  "  }",
                  "}, (err, res) => {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Error code CONFLICT', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('CONFLICT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dup Turbine 2\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"{{dupSerial}}\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.61 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2024-01-15\"\n}"
            },
            "url": "{{baseUrl}}/api/equipment",
            "description": "Creates one equipment in prerequest, then posts the same serialNumber again."
          }
        },
        {
          "name": "409 invalid status transition",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Error code CONFLICT', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('CONFLICT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"done\"\n}"
            },
            "url": "{{baseUrl}}/api/requests/{{requestId}}/status",
            "description": "Expects request currently in new or already closed. Prefer running after create (new → done is invalid)."
          }
        },
        {
          "name": "429 rate limit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 429 when limit exceeded', () => {",
                  "  pm.expect([200, 429]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 429) {",
                  "  pm.test('Error code RATE_LIMIT_EXCEEDED', () => {",
                  "    pm.expect(pm.response.json().error.code).to.eql('RATE_LIMIT_EXCEEDED');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Set RATE_LIMIT_MAX=3, restart server, send this request 4+ times quickly (or use Collection Runner)."
          }
        }
      ]
    }
  ]
}
