    {
      "name": "Setup",
      "item": [
        {
          "name": "Resolve seed IDs (site + technicians)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const eqBody = pm.response.json();",
                  "if (eqBody?.data?.length) {",
                  "  pm.collectionVariables.set('siteId', eqBody.data[0].siteId);",
                  "}",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/requests?page=1&limit=50',",
                  "  method: 'GET',",
                  "  header: { Authorization: 'Bearer ' + pm.collectionVariables.get('accessToken') },",
                  "}, (err, res) => {",
                  "  if (err || res.code !== 200) return;",
                  "  const rows = res.json().data || [];",
                  "  const ids = [];",
                  "  for (const r of rows) {",
                  "    for (const a of r.assignees || []) {",
                  "      if (a.technician?.id && !ids.includes(a.technician.id)) {",
                  "        ids.push(a.technician.id);",
                  "      }",
                  "    }",
                  "  }",
                  "  if (ids[0]) pm.collectionVariables.set('technicianId', ids[0]);",
                  "  if (ids[0]) pm.collectionVariables.set('technicianId2', ids[1] || ids[0]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment?page=1&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipment"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Requires npm run seed and Login (accessToken). Saves siteId and technician IDs from seeded data."
          }
        }
      ]
    },
