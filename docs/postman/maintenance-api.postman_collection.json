        {
          "name": "409 in_progress without assignees",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.collectionVariables.get(\"baseUrl\");",
                  "",
                  "const equipmentId = pm.collectionVariables.get(\"equipmentId\");",
                  "pm.sendRequest({",
                  "  url: baseUrl + \"/api/requests\",",
                  "  method: \"POST\",",
                  "  header: { \"Content-Type\": \"application/json\", Authorization: \"Bearer \" + pm.collectionVariables.get(\"accessToken\") },",
                  "  body: {",
                  "    mode: \"raw\",",
                  "    raw: JSON.stringify({",
                  "      equipmentId,",
                  "      title: \"No crew request \" + Date.now(),",
                  "      description: \"For 409 in_progress without assignees\",",
                  "      priority: \"low\"",
                  "    })",
                  "  }",
                  "}, (err, res) => {",
                  "  if (!err && res.code === 201) {",
                  "    pm.collectionVariables.set(\"lonelyRequestId\", res.json().data.id);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\"\n}"
            },
            "url": "{{baseUrl}}/api/requests/{{lonelyRequestId}}/status",
            "description": "Creates a fresh request in prerequest, then tries in_progress without assignees."
          }
        },
